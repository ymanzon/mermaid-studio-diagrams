sequenceDiagram
    participant c2 as CheckoutWeb
    participant c1 as Dispositivo movil
    participant ms1 as AppEstadoDeCuenta
    participant buss1 as BusMonedero
    participant dat1 as DatMonedero
    participant DB as DbContext
    participant ms2 as PagosCommandService

    opt [GENERAR CVV]
        c1->>ms1:POST	/api-movil/monederos/{idMonedero}/CVV
        ms1->>buss1:BGenerarCVV(idMonedero)
        buss1->>dat1:DObtenerCVV(idMonedero)
        alt [TRY]
          dat1->>dat1:fechaActual = DateTime.UtcNow()
          dat1->>DB:_DbContext.CVVMonedero.Where(x=>x.uidMonedero == uidMonedero && x.DFechaExpiracion > fechaActual).FirstOrDefault()
          DB-->>dat1:CVVMonedero
          dat1-->>buss1:Response.SetSuccess(Map<EntCVV, CVVMonedero>(CVV))
        else [CATCH]
          dat1-->>buss1:Response.SetError("Ocurrio un error al obtener el registro.")
        end

        alt [Response.HasError == true] Error al obtener el CCV
		      buss1-->>ms1:Response.SetError("Ocurrio un error al generar el CVV")
          ms1-->>c1:Response.SetError("Ocurrio un error al generar el CVV")
        else [Response.HasError == false && Response.Result != null] Se encontro un CVV aun no expirado
          buss1->>buss1:CVV.ExpiraEn = (int)Math.Ceiling((CVV.FechaExpiracion - fechaActual).TotalSeconds);
          buss1-->>ms1:Response.SetSuccess(CVV)
          ms1-->>c1:Response.SetSuccess(CVV)
        end

        buss1-->>buss1: entCVV.idMonedero= idMonedero
        buss1-->>buss1: entCVV.CVV = Random(100,999)
        buss1-->>buss1: entCVV.fechaActual = DateTime.UtcNow()
        buss1-->>buss1: entCVV.tiempoExpiracion = Parametros.Get("TIEMPO_EXPIRACION")
        buss1-->>buss1: entCVV.fechaExpiracion = fechaActual.AddSeconds(tiempoExpiracion)
        buss1->>dat1:DCrearCVV(entCVV);

        alt [TRY]
          dat1-->>DB:_DbContext.CVVMonedero.Add(CVVMonedero);
          dat1-->>DB:affectedRecords = _DbContext.CVVMonedero.SaveChanges()

          alt [affectedRecords > 0] Si se afectaron registros
            dat1-->>buss1:Response.SetSuccess(Map<EntCCV, CVVMonedero>(CVVMonedero))
          else [affectedRecords <= 0] si no se actualizaron registros
            dat1-->>buss1:Response.SetError("Error al registrar el CVV")
          end
        else [CATCH]
          dat1-->>buss1: Response.SetError("No se pudo registrar el CVV del monedero.")
        end

        alt [Response.HasError == true]
          buss1-->>ms1:Response.SetError(No se pudo generar el CVV)
          ms1-->>c1:Response.SetError(No se pudo generar el CVV)
        end
        buss1-->>ms1:Response.SetSuccess(CVVMonedero)
        ms1-->>c1:Response.SetSuccess(CVVMonedero)
    end