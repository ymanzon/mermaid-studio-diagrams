sequenceDiagram
    participant c2 as CheckoutWeb
    participant c1 as Dispositivo movil
    participant ms1 as AppEstadoDeCuenta
    participant buss1 as BusMonedero
    participant dat1 as DatMonedero
    participant DB as DbContext
    participant ms2 as PagosCommandService

    opt Validar CCV 
        c2->>ms1: POST	/api/monederos/{idMonedero}/cvv/validar {cvv:cvv}
        ms1->>buss1: BValidarCCV(uidMonedero, cvv)
        buss1->>dat1: DObtenerCCV(uidMonedero,cvv)
        dat1->>DB:_dbContext.CCVMonedero.Where(x=>x.uidMonedero == uidMonedero && x.CCV == cvv).FirstOrDefaultAsync()
        dat1-->>dat1: Map<EntCCV, CCVMonedero>(Response.Result)
        dat1->>buss1:Response<EntCCV>
        alt CCV no existe o CCV existe y ya expiró
            buss1-->>ms1:Error("CCV no válido")
            ms1-->>c2:Error("CCV no válido")
        else
            buss1-->>ms1:Success("CCV válido")
            ms1-->>c2:Success("CCV válido")
        end
    end



