sequenceDiagram
    participant c2 as CheckoutWeb
    participant c1 as Dispositivo movil
    participant ms1 as AppEstadoDeCuenta
    participant buss1 as BusMonedero
    participant dat1 as DatMonedero
    participant DB as DbContext
    participant ms2 as PagosCommandService

    opt Obtener o regenerar CCV 
        c1->>ms1:ObtenerCCV(uidMonedero)
        ms1->>buss1:BObtenerCCV(uidMonedero)
        buss1->>dat1:DObtenerCCVPorMonedero(uidMonedero)
        dat1-->>dat1:Debug()
        alt [TRY]
          dat1->>DB:_dbContext.CCVMonedero.Where(x=>x.uidMonedero == uidMonedero).FirstOrDefaultAsync()
          alt si no retorna valor
            dat1-->>buss1:null
          else
            dat1->>dat1:Map<EntCCV, CCVMonedero>(Response.Result)
            dat1-->>buss1: Response<EntCCV>
          end
        else CATCH
          dat1->>buss1:Message(Ocurrio un error al obtener el registro)
        end
        alt CCV se encontro o CCV existe y ya expiró
            buss1->>buss1:ObtenerParametro(TIEMPO_EXPIRACION)
            buss1->>buss1:GenerarCCV(uidMonedero, TIEMPO_EXPIRACION)
            buss1->>dat1:DGuardar(CCV)
            dat1->>DB:_dbContext.CCVMonedero.Add(CCV)
            dat1->>DB:_dbContext.SaveChanges()
            dat1-->>buss1:Result<CCVMonedero>
        end
        buss1-->>ms1:Response<EntCCV>
        ms1-->>c1: Response<EntCCV>
    end

    opt Validar CCV 
        c2->>ms1: CValidarCCV(uidMonedero, CCV)
        ms1->>buss1: BValidarCCV(uidMonedero, CCV)
        buss1->>dat1: DObtenerCCVPorMonederoYCCV(uidMonedero,CCV)
        dat1->>DB:_dbContext.CCVMonedero.Where(x=>x.uidMonedero == uidMonedero && x.CCV == CCV).FirstOrDefaultAsync()
        dat1-->>dat1: Map<EntCCV, CCVMonedero>(Response.Result)
        dat1->>buss1:Response<EntCCV>
        alt CCV no existe o CCV existe y ya expiró
            buss1-->>ms1:Error("CCV no válido")
            ms1-->>c2:Error("CCV no válido")
        else
            buss1-->>ms1:Success("CCV válido")
            ms1-->>c2:Success("CCV válido")
        end
    end



